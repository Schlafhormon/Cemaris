# Release tag for both application images
CEMARIS_IMAGE_TAG=0.2.0
# Read by the API from the working directory; Compose passes these values.
CEMARIS_ENVIRONMENT=development
CEMARIS_LOG_LEVEL=info
CEMARIS_WEB_PORT=8080
# Deployment prefix: empty for root, e.g. /cemaris; rebuilding web is required.
# Set the same full public URL in CEMARIS_APP_URL below. See docs/DEPLOYMENT.md.
CEMARIS_URL_PREFIX=
# Exact source IP/CIDR of the HTTPS host proxy as seen from the web container.
# Default trusts only loopback; determine the actual Docker gateway on Ubuntu.
CEMARIS_TRUSTED_PROXY_CIDR=127.0.0.1
# API container clock for daily tasks. Choose Europe/Berlin if that is desired.
CEMARIS_TIME_ZONE=Europe/Berlin
# Required for migration and Compose. /api/health is process liveness; the
# container additionally checks database connectivity and Alembic revision.
# Percent-encode URL credentials. SQL Server 2019+ and ODBC Driver 18 required.
# CEMARIS_DATABASE_URL=mssql+pyodbc://cemaris:password@localhost:1433/CemarisPortTest?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# Windows local development with integrated authentication (local certificate only):
# CEMARIS_DATABASE_URL=mssql+pyodbc://@localhost\CEMARISDEV/CemarisPort_Development?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
# Test-only administration URL: tests CREATE their own random cemaris_test_02_* DB
# and DROP only that database. Never supply an existing application DB here.
# CEMARIS_SQL_TEST_ADMIN_URL=mssql+pyodbc://@localhost\CEMARISDEV/master?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes

# Authentication has no default password/provider. See docs/TECHNIK.md.
# JSON credentials are operator configuration, never browser configuration.
# Local plainText example: choose your own password and uncomment both lines.
# Empty domain STILL prefixes a backslash in Sunrise's authentication contract.
# In JSON password strings use \u0024 for $ and \u0023 for #, avoiding dotenv
# interpolation/comments in both the native API and Compose.
# CEMARIS_AUTH_TYPE=plainText
# CEMARIS_AUTH_CONFIG={"users":{"\\administrator":"CHOOSE_A_LOCAL_DEVELOPMENT_PASSWORD"}}
CEMARIS_AUTH_DOMAIN=
CEMARIS_AUTH_CAN_LOGIN='["administrator"]'
CEMARIS_AUTH_IS_ADMIN='["administrator"]'
CEMARIS_AUTH_CAN_UPDATE='[]'
CEMARIS_AUTH_CAN_UPDATE_CEMETERIES='[]'
CEMARIS_AUTH_CAN_UPDATE_CONTRACTS='[]'
CEMARIS_AUTH_CAN_UPDATE_WORK_ORDERS='[]'
CEMARIS_AUTH_MAX_AGE_MILLIS=3600000
CEMARIS_AUTH_DO_KEEP_ALIVE=false
CEMARIS_AUTH_SESSION_DIRECTORY=data/sessions
# Direct local HTTP: false. Compose defaults true for access through HTTPS.
# CEMARIS_AUTH_COOKIE_SECURE=false
# Compose nginx supplies the client IP; direct local API uses false by default.
# CEMARIS_AUTH_TRAFFIC_IS_FORWARDED=false
CEMARIS_AUDIT_LOG_ENABLED=false
# Suppress writes while keeping enabled audit views available; source DISABLE_AUDIT_LOG alias supported.
CEMARIS_DISABLE_AUDIT_LOG=false
CEMARIS_RECORD_DELETE_AGE_DAYS=60
CEMARIS_BACKUP_TASK_ENABLED=false
CEMARIS_BACKUP_HOUR=2
CEMARIS_BACKUP_DELETE_AGE_DAYS=0
# Absolute directory on the SQL SERVER host; unset uses its instance default.
# CEMARIS_BACKUP_DIRECTORY=D:\SQLBackups\Cemaris
# Optional local/shared mapping of the SAME directory, for scoped file retention.
# Mount that shared folder explicitly before configuring this API-side path.
# CEMARIS_BACKUP_LOCAL_DIRECTORY=/app/sql-backups
# Catalog administration and document selection (JSON lists/maps).
CEMARIS_CONTRACT_PRINTS='["screen/contract"]'
CEMARIS_CUSTOM_PDF_PRINT_TITLES='{}'
# Loaded customizations/index.js prints.pdf titles are discovered automatically.
CEMARIS_FEE_TAX_PERCENTAGE_DEFAULT=0
# Cemetery/burial site forms. JSON uses the original five segment descriptors.
CEMARIS_BURIAL_SITE_NAME_SEGMENTS='{"includeCemeteryKey":false,"separator":"-","segments":{"1":{"isAvailable":true,"isRequired":true,"label":"Plot Number","minLength":1,"maxLength":20}}}'
CEMARIS_CUSTOMIZATIONS_PATH=.
# Docker Compose mounts this host directory at /app/customizations (read only).
CEMARIS_CUSTOMIZATIONS_HOST_PATH=./customizations
# Cache image/SVG discovery until restart, as Sunrise does by default. When
# enabled, rescan on each request to observe additions and deletions.
CEMARIS_BURIAL_SITE_REFRESH_IMAGE_CHANGES=false
CEMARIS_CEMETERY_REFRESH_IMAGE_CHANGES=false
CEMARIS_LATITUDE_MIN=-90
CEMARIS_LATITUDE_MAX=90
CEMARIS_LONGITUDE_MIN=-180
CEMARIS_LONGITUDE_MAX=180
CEMARIS_ADDRESS_LABELS=de
CEMARIS_CONTRACT_END_DATE_IS_AVAILABLE=true
# Contracts: source number generation and browser form requirements.
CEMARIS_CONTRACT_NUMBER_LENGTH=10
CEMARIS_CONTRACT_BURIAL_SITE_ID_IS_REQUIRED=true
CEMARIS_CONTRACT_END_DATE_IS_REQUIRED=false
# Work orders: original numbering, calendar organizer and path/title references.
# Set the public URL for links behind a reverse proxy, matching application.appUrl.
# CEMARIS_APP_URL=https://cemaris.example.invalid
CEMARIS_WORK_ORDER_NUMBER_LENGTH=6
CEMARIS_WORK_ORDER_CALENDAR_EMAIL_ADDRESS=no-reply@127.0.0.1
CEMARIS_WORK_ORDER_CALENDAR_PRINTS='[["pdf/workOrder","Work Order Field Sheet"],["pdf/workOrder-commentLog","Work Order Field Sheet - Comment Log"]]'
# Files remain on disk after soft deletion, as in Sunrise; include this directory
# together with SQL Server in backups. Compose uses a named attachments volume.
CEMARIS_ATTACHMENTS_PATH=data/attachments
CEMARIS_MAX_ATTACHMENT_FILE_SIZE=20
# PDFs use an installed browser; the API image includes Chromium. Locally the
# renderer discovers Edge/Chrome, or use an explicit executable path.
# CEMARIS_PRINT_BROWSER_EXECUTABLE=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
CEMARIS_PRINT_CONTENT_DISPOSITION=attachment
CEMARIS_PRINT_BROWSER=chrome
# Extra public original dotted configuration keys for custom EJS templates:
CEMARIS_PRINT_CONFIGURATION='{}'
